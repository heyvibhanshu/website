# Supabase project URL and PUBLIC publishable key. A server-only worker key is optional below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Required server-only path for the writing desk; no built-in fallback.
# Choose one lowercase path segment with letters, numbers, or hyphens.
CMS_ADMIN_PATH=

# Optional search-engine verification tokens (leave blank until supplied).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow: set these only in Production after applying the outbox migration.
# Generate each key independently with: openssl rand -hex 32
INDEXNOW_KEY=
CRON_SECRET=
# Privileged server-only key for the outbox worker. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
